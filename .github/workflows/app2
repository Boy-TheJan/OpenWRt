name: Build OpenWrt MAIN J4125
on:
  workflow_dispatch:
  push:
    branches:
      - main

env:
  OPENWRT_BRANCH: main
  FIRMWARE_TAG: MAIN-J4125-I225Vx4-PERF
  CI_DEBUG: true

jobs:
  build:
    runs-on: ubuntu-22.04
    steps:
      - name: Checkout workflow
        uses: actions/checkout@v4

      - name: Install dependencies
        run: |
          sudo apt-get update
          sudo apt-get install -y build-essential gcc g++ binutils flex bison gawk autoconf automake libtool ccache libncurses-dev git curl wget unzip rsync python3-pip python3-setuptools libssl-dev qemu-utils cpufrequtils

      - name: Clone OpenWrt source
        run: |
          git clone --depth 1 --branch ${{ env.OPENWRT_BRANCH }} https://github.com/openwrt/openwrt.git openwrt
          cd openwrt
          cp feeds.conf.default feeds.conf

      - name: Custom source modification & Performance tuning
        run: |
          cd openwrt
          echo "===== Start performance tuning ====="

          # 内核配置（x86）
          echo 'CONFIG_TCP_CONG_BBR=y' >> target/linux/x86/config-6.6
          echo 'CONFIG_DEFAULT_TCP_CONG="bbr"' >> target/linux/x86/config-6.6
          echo 'CONFIG_TCP_FASTOPEN=y' >> target/linux/x86/config-6.6
          echo 'CONFIG_VM_SWAPPINESS=10' >> target/linux/x86/config-6.6
          echo 'CONFIG_NF_FLOW_TABLE=y' >> target/linux/x86/config-6.6
          echo 'CONFIG_NF_FLOW_TABLE_PROCFS=y' >> target/linux/x86/config-6.6
          echo 'CONFIG_NET_RX_BUSY_POLL=y' >> target/linux/x86/config-6.6
          echo 'CONFIG_BQL=y' >> target/linux/x86/config-6.6
          echo '# CONFIG_DEBUG_KERNEL is not set' >> target/linux/x86/config-6.6
          echo '# CONFIG_DEBUG_FS is not set' >> target/linux/x86/config-6.6
          echo 'CONFIG_MEMCG=y' >> target/linux/x86/config-6.6

          # sysctl性能调优文件
          mkdir -p package/base-files/files/etc/sysctl.d
          cat > package/base-files/files/etc/sysctl.d/99-performance.conf <<'EOF'
net.ipv4.tcp_keepalive_time = 600
net.ipv4.tcp_keepalive_intvl = 30
net.ipv4.tcp_keepalive_probes = 3
net.ipv4.tcp_syn_retries = 2
net.ipv4.tcp_synack_retries = 2
net.ipv4.tcp_fin_timeout = 30
net.ipv4.tcp_tw_reuse = 1
net.ipv4.tcp_max_tw_buckets = 20000
net.ipv4.tcp_max_syn_backlog = 8192
net.ipv4.tcp_window_scaling = 1
net.netfilter.nf_conntrack_max = 262144
net.netfilter.nf_conntrack_tcp_timeout_established = 3600
net.netfilter.nf_conntrack_tcp_timeout_time_wait = 30
vm.swappiness = 10
vm.dirty_ratio = 10
vm.dirty_background_ratio = 5
net.core.busy_poll = 50
net.core.busy_read = 50
net.core.rmem_max = 16777216
net.core.wmem_max = 16777216
net.core.rmem_default = 262144
net.core.wmem_default = 262144
EOF

          # IRQ中断均衡脚本(I225‑V网卡)
          mkdir -p package/base-files/files/etc/init.d
          cat > package/base-files/files/etc/init.d/irqbalance_tune <<'EOF'
#!/bin/sh /etc/rc.common
START=15
start() {
    for irq in $(grep -i i225 /proc/interrupts | awk '{print $1}' | sed 's/://');do
        echo 0f > /proc/irq/$irq/smp_affinity
    done
}
EOF
          chmod +x package/base-files/files/etc/init.d/irqbalance_tune
          echo "/etc/init.d/irqbalance_tune enable" >> package/base-files/files/etc/rc.local

          # 基础系统配置：LAN IP、时区、主机名
          sed -i 's/192.168.1.1/192.168.1.11/g' package/base-files/files/bin/config_generate
          sed -i '/set system.@system\[0\].timezone/d' package/base-files/files/bin/config_generate
          echo 'set system.@system[0].timezone=CST-8' >> package/base-files/files/bin/config_generate
          echo 'set system.@system[0].zonename=Asia/Shanghai' >> package/base-files/files/bin/config_generate
          sed -i 's/OpenWrt/J4125-Router/g' package/base-files/files/bin/config_generate

          echo "===== Performance tuning done ====="

      - name: Feeds update with retry
        run: |
          cd openwrt
          ./scripts/feeds update -a || ./scripts/feeds update -a
          ./scripts/feeds install -a

      - name: Add third‑party packages
        run: |
          cd openwrt
          git clone --depth 1 https://github.com/Openwrt-Passwall/openwrt-passwall package/openwrt-passwall
          git clone --depth 1 https://github.com/Openwrt-Passwall/openwrt-passwall-packages package/openwrt-passwall-packages
          git clone --depth 1 https://github.com/jerrykuku/luci-theme-argon package/luci-theme-argon

      - name: Generate .config
        run: |
          cd openwrt
          make defconfig
          echo 'CONFIG_TARGET_x86=y' >> .config
          echo 'CONFIG_TARGET_x86_64=y' >> .config
          echo 'CONFIG_TARGET_x86_64_Generic=y' >> .config
          echo 'CONFIG_TARGET_IMAGES_GZIP=y' >> .config
          echo 'CONFIG_TARGET_IMAGES_COMBINED_EFI=y' >> .config
          echo 'CONFIG_TARGET_IMAGES_COMBINED_VMDK=y' >> .config

          echo 'CONFIG_PACKAGE_kmod-net-igc=y' >> .config
          echo 'CONFIG_PACKAGE_kmod-igc=y' >> .config

          echo 'CONFIG_PACKAGE_kmod-usb-core=y' >> .config
          echo 'CONFIG_PACKAGE_kmod-usb-xhci=y' >> .config
          echo 'CONFIG_PACKAGE_kmod-sound-hda-intel=y' >> .config
          echo 'CONFIG_PACKAGE_kmod-i915=y' >> .config
          echo 'CONFIG_PACKAGE_kmod-i2c-i801=y' >> .config

          echo 'CONFIG_PACKAGE_ipv6helper=y' >> .config
          echo 'CONFIG_PACKAGE_odhcpd-ipv6=y' >> .config
          echo 'CONFIG_PACKAGE_6in4=y' >> .config
          echo 'CONFIG_PACKAGE_6rd=y' >> .config
          echo 'CONFIG_PACKAGE_luci-proto-dhcpv6=y' >> .config
          echo 'CONFIG_PACKAGE_dnsmasq-full=y' >> .config

          echo 'CONFIG_PACKAGE_kmod-nft-offload=y' >> .config
          echo 'CONFIG_PACKAGE_kmod-flow-offload=y' >> .config
          echo 'CONFIG_PACKAGE_cpufrequtils=y' >> .config
          echo 'CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE=y' >> .config

          echo '# CONFIG_PACKAGE_odhcpd-ipv6only is not set' >> .config
          echo '# CONFIG_PACKAGE_ppp is not set' >> .config
          echo '# CONFIG_PACKAGE_pppoe-discovery is not set' >> .config

          echo 'CONFIG_PACKAGE_luci=y' >> .config
          echo 'CONFIG_PACKAGE_luci-theme-argon=y' >> .config
          echo 'CONFIG_PACKAGE_luci-i18n-zh-cn=y' >> .config
          echo 'CONFIG_PACKAGE_luci-app-passwall=y' >> .config

          echo 'CONFIG_PACKAGE_iperf3=y' >> .config
          echo 'CONFIG_PACKAGE_tcpdump=y' >> .config
          echo 'CONFIG_PACKAGE_curl=y' >> .config
          echo 'CONFIG_PACKAGE_wget-ssl=y' >> .config
          echo 'CONFIG_PACKAGE_nload=y' >> .config
          echo 'CONFIG_PACKAGE_htop=y' >> .config

          make oldconfig

      - name: Compile firmware
        run: |
          cd openwrt
          make -j$(nproc) V=s

      - name: Upload artifact
        uses: actions/upload-artifact@v4
        with:
          name: ${{ env.FIRMWARE_TAG }}
          path: |
            openwrt/bin/targets/x86/64/*.gz
            openwrt/bin/targets/x86/64/*.vmdk

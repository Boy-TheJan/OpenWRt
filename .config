CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_GENERIC=y

CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_VMDK_IMAGES=y
CONFIG_QCOW2_IMAGES=y
CONFIG_RAW_IMAGES=y
CONFIG_GRUB_EFI=y
CONFIG_GRUB_LEGACY=y
CONFIG_TARGET_KERNEL_PARTSIZE=256
# 关键修复：512M扩容至800M，解决镜像打包超出容量崩溃
CONFIG_TARGET_ROOTFS_PARTSIZE=800
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=n

CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y

CONFIG_PACKAGE_kmod-igc=y

CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-mark=y

CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ipv6helper=y

CONFIG_PACKAGE_ddns-scripts=y
CONFIG_PACKAGE_ddns-scripts_aliyun=y

CONFIG_PACKAGE_wireguard=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_luci-app-wireguard=y

CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_SINGBOX=y
CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_XRAY=n

CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_luci-app-wol=y

CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-compat=y

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wireguard-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_htop=y

CONFIG_PACKAGE_docker=n
CONFIG_PACKAGE_dockerd=n
CONFIG_PACKAGE_kmod-wireless=n
CONFIG_PACKAGE_wireless-tools=n
CONFIG_PACKAGE_mwan3=n
CONFIG_PACKAGE_samba4=n
CONFIG_PACKAGE_miniupnpd=n
CONFIG_PACKAGE_avahi-daemon=n
CONFIG_PACKAGE_vsftpd=n
CONFIG_PACKAGE_odhcpd=n
